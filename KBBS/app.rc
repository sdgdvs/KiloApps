1 ICON "icon.ico"
#include <windows.h>

1000 DIALOGEX 0, 0, 300, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Dialing Directory"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LISTBOX         1001, 5, 5, 120, 190, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Name:", -1, 135, 10, 40, 8
    EDITTEXT        1002, 175, 8, 115, 14, ES_AUTOHSCROLL
    LTEXT           "Host:", -1, 135, 28, 40, 8
    EDITTEXT        1003, 175, 26, 115, 14, ES_AUTOHSCROLL
    LTEXT           "Port:", -1, 135, 46, 40, 8
    EDITTEXT        1004, 175, 44, 40, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Type:", -1, 135, 64, 40, 8
    COMBOBOX        1005, 175, 62, 70, 50, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "AutoLogin:", -1, 135, 82, 40, 8
    EDITTEXT        1009, 175, 80, 115, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Save", 1006, 135, 105, 50, 14
    PUSHBUTTON      "New", 1007, 190, 105, 50, 14
    PUSHBUTTON      "Delete", 1008, 245, 105, 45, 14
    DEFPUSHBUTTON   "Connect", 1, 135, 175, 75, 16
    PUSHBUTTON      "Cancel", 2, 215, 175, 75, 16
END

2000 DIALOGEX 0, 0, 300, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Macros (Alt + Key)"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LISTBOX         2001, 5, 5, 120, 190, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Key (e.g. L):", -1, 135, 10, 50, 8
    EDITTEXT        2002, 190, 8, 20, 14, ES_AUTOHSCROLL | ES_UPPERCASE
    LTEXT           "Sequence (use \\r):", -1, 135, 28, 100, 8
    EDITTEXT        2003, 135, 40, 155, 60, ES_MULTILINE | ES_WANTRETURN | WS_VSCROLL
    PUSHBUTTON      "Save", 2006, 135, 110, 50, 14
    PUSHBUTTON      "New", 2007, 190, 110, 50, 14
    PUSHBUTTON      "Delete", 2008, 245, 110, 45, 14
    PUSHBUTTON      "Close", 2, 215, 175, 75, 16
END

3000 DIALOGEX 0, 0, 180, 140
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Display Settings"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Font Size (px):", -1, 10, 12, 60, 8
    EDITTEXT        3001, 80, 10, 40, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Blink Rate (ms):", -1, 10, 32, 60, 8
    EDITTEXT        3002, 80, 30, 40, 14, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "Local Echo", 3003, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 50, 60, 10
    LTEXT           "Baud Rate:", -1, 10, 67, 50, 8
    COMBOBOX        3006, 80, 65, 80, 50, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Palette...", 3004, 10, 85, 50, 14
    PUSHBUTTON      "Reset Palette", 3005, 65, 85, 60, 14
    DEFPUSHBUTTON   "Save", 1, 30, 115, 50, 14
    PUSHBUTTON      "Cancel", 2, 90, 115, 50, 14
END

4000 DIALOGEX 0, 0, 220, 180
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Help / Quick Reference"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "KBBS Terminal Help:", -1, 10, 10, 200, 8
    LTEXT           "- Dialing Directory: Save & quick-connect to BBSs", -1, 10, 25, 200, 8
    LTEXT           "- XMODEM / ZMODEM: Click DL/UL to transfer files", -1, 10, 40, 200, 8
    LTEXT           "- ANSI Music: Plays BBS tones automatically", -1, 10, 55, 200, 8
    LTEXT           "- Macros: Alt+Key sequence bindings (use \\r)", -1, 10, 70, 200, 8
    LTEXT           "- Display Settings: Font size & blink rate", -1, 10, 85, 200, 8
    LTEXT           "- Scrollback: Shift+PgUp / Shift+PgDn or Wheel", -1, 10, 100, 200, 8
    LTEXT           "- Selection: Drag to select, copies to clipboard", -1, 10, 115, 200, 8
    LTEXT           "- Session Capture: Cap button logs to text file", -1, 10, 130, 200, 8
    LTEXT           "- EchoNet / Msgs: Browse conferences & stream", -1, 10, 145, 200, 8
    DEFPUSHBUTTON   "OK", 1, 85, 160, 50, 14
END

5000 DIALOGEX 0, 0, 360, 230
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "BBS Message Base & FidoNet EchoMail Reader"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Area / Sub-Board:", -1, 5, 8, 70, 8
    COMBOBOX        5001, 80, 6, 140, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Conference Messages:", -1, 5, 24, 80, 8
    LISTBOX         5002, 5, 35, 140, 160, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Message Header & Content:", -1, 150, 24, 100, 8
    EDITTEXT        5003, 150, 35, 205, 160, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON      "Stream to Term", 5004, 5, 204, 70, 16
    PUSHBUTTON      "New Post", 5005, 80, 204, 50, 16
    PUSHBUTTON      "Prev", 5006, 135, 204, 35, 16
    PUSHBUTTON      "Next", 5007, 175, 204, 35, 16
    DEFPUSHBUTTON   "Close", 1, 300, 204, 55, 16
END

5100 DIALOGEX 0, 0, 280, 190
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Compose EchoMail Message"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Area:", -1, 10, 10, 25, 8
    COMBOBOX        5101, 40, 8, 120, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "To:", -1, 170, 10, 15, 8
    EDITTEXT        5102, 190, 8, 80, 14, ES_AUTOHSCROLL
    LTEXT           "Subject:", -1, 10, 28, 30, 8
    EDITTEXT        5103, 40, 26, 230, 14, ES_AUTOHSCROLL
    LTEXT           "Message Body:", -1, 10, 46, 60, 8
    EDITTEXT        5104, 10, 58, 260, 105, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL
    DEFPUSHBUTTON   "Post", 1, 165, 168, 50, 16
    PUSHBUTTON      "Cancel", 2, 220, 168, 50, 16
END
